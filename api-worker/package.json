{
	"name": "cloudflare-workers-openapi",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy -c wrangler.toml",
		"dev": "wrangler dev -c wrangler.toml",
		"start": "wrangler dev -c wrangler.toml",
		"cf-typegen": "wrangler types --include-env=true --env-file .typegen.env -c wrangler.toml",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:types": "wrangler types --check --include-env=true --env-file .typegen.env -c wrangler.toml",
		"r2:lifecycle:apply": "wrangler r2 bucket lifecycle set mcp-finder-db-snapshots --file r2-lifecycle.json --force"
	},
	"dependencies": {
		"hono": "^4.13.3"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"@types/service-worker-mock": "^2.0.4",
		"typescript": "^5.9.3",
		"wrangler": "^4.124.0"
	}
}
